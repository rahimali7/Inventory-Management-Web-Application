# Copy to .env.local and fill in. .env.local is gitignored.
# On a host such as Vercel, set these in the project's environment settings
# instead of committing them.

# Masjidal API key (the "msj_pk_..." value from the Masjidal dashboard).
#
# NOTE: anything prefixed NEXT_PUBLIC_ is inlined into the JavaScript bundle
# at build time and is therefore visible to every visitor. That is correct for
# a publishable/browser key (the "pk" in "msj_pk" conventionally means exactly
# that), but it is the WRONG place for a secret key. If this value is meant to
# stay private, it must be used from a server route instead — drop the
# NEXT_PUBLIC_ prefix and read it server-side only.
NEXT_PUBLIC_MASJIDAL_API_KEY=
